# From Supabase: Project Settings -> API
# Functions URL is https://<project-ref>.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# The "anon" public key from the same page - safe to expose in frontend code
VITE_SUPABASE_ANON_KEY=your_anon_key_here
