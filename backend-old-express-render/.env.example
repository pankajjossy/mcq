# Copy this file to .env and fill in real values. Never commit .env itself.

# From Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Any long random string (used to sign login tokens)
JWT_SECRET=change_this_to_a_long_random_string

# From https://aistudio.google.com/app/apikey (free tier, no card needed)
GEMINI_API_KEY=your_gemini_api_key_here

# Port Render will inject automatically; 5000 is just the local default
PORT=5000

# Your deployed frontend URL, so CORS allows it (comma-separate multiple)
FRONTEND_ORIGIN=http://localhost:5173
